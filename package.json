{
  "name": "kuzma",
  "description": "Your own Claude in Telegram — personal AI assistant with voice, forums, and scheduled tasks",
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "author": "Aleksandr Malakhov",
  "repository": {
    "type": "git",
    "url": "https://github.com/malakhov-dmitrii/kuzma.git"
  },
  "keywords": ["telegram", "claude", "ai", "assistant", "bot", "voice", "mcp"],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --hot src/index.ts",
    "stop": "lsof -ti :${ASK_USER_BRIDGE_PORT:-3848} | xargs kill 2>/dev/null && echo 'Stopped.' || echo 'Not running.'",
    "doctor": "bun run scripts/doctor.ts",
    "test": "bun test",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "setup": "bun run scripts/setup.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.3.9"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "croner": "^10.0.1",
    "grammy": "^1.41.0",
    "p-queue": "^9.1.0",
    "zod": "^4.3.6"
  }
}
