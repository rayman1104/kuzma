# Required — Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required — your Telegram user ID (for auth). Get it from @userinfobot
TELEGRAM_USER_ID=

# Parakeet STT service URL (default: http://localhost:5092)
# PARAKEET_URL=http://localhost:5092

# Obsidian vault path (default: ~/vault)
# VAULT_PATH=~/vault

# Workspace path for system prompts (default: ~/workspace)
# WORKSPACE_PATH=~/workspace

# SQLite database path (default: ./data/kuzma.db)
# DB_PATH=./data/kuzma.db

# HTTP bridge port for ask_user MCP (default: 3847)
# ASK_USER_BRIDGE_PORT=3847
